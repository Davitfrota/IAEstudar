# Supabase (Auth + DB)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Preferência: sessão do usuário (RLS). Só force service role se necessário:
# USE_SERVICE_ROLE_DB=true

# Groq (agente + generate_form)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Planos pendentes + rate limit (obrigatório em produção)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# REDIS_URL=

# Health detalhado em produção (opcional)
# HEALTH_CHECK_TOKEN=

# Testes E2E autenticados (opcional)
# E2E_EMAIL=
# E2E_PASSWORD=
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Diagnóstico: GET /api/health (em prod: token ou resposta mínima)

# MCP stdio (opcional) — UUID do auth.users
IA_ESTUDAR_USER_ID=
